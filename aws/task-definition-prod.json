{
    "requiresCompatibilities": [
        "FARGATE"
    ],
    "family": "learnJenkinsApp-TaskDefinition-prod",
    "containerDefinitions": [
        {
            "name": "Learnjenkinsapp",
            "image": "nginx:1.27-alpine",
             "portMappings": [{
                 "name":"nginx-80-tip",
                 "containerPort": 80,
                 "hostPort": 80,
                 "protocol": "tcp",
                 "appProtocol": "http"
                 
             }],
            "essential": true
        }
    ],
    "volumes": [],
    "networkMode": "awsvpc",
    "memory": "1024",
    "cpu": "512",
    "executionRoleArn": ""
}